@page
@using Inkshelf.Convert
@model Inkshelf.Pages.SettingsModel
<div class="page-head">
    <h1 class="page-title">
        <a href="/?all=1" class="home-link" title="@L["Libraries"]"><img src="~/img/icon-black.png" alt="" class="title-icon" /></a>
        <a href="/?all=1">@L["Libraries"]</a> <span class="crumb-sep">›</span> @L["Settings"]
    </h1>
</div>

<p class="settings-note">@L["These settings apply to this device / browser only."]</p>
@if (Model.DetectedScreen is not null)
{
    <p class="settings-note">@L["Detected screen: {0}", Model.DetectedScreen]</p>
}

<form class="settings-form" method="post" action="/settings">
    @Html.AntiForgeryToken()
    <p>
        <label>
            <input type="checkbox" name="retina" value="on" @(Model.Settings.Retina ? "checked" : "") />
            @L["Retina pages (full-resolution; crisper but heavier — may strain low-memory readers)"]
        </label>
    </p>
    <p>
        <label>
            <input type="checkbox" name="grayscale" value="on" @(Model.Settings.Grayscale ? "checked" : "") />
            @L["Grayscale pages (smaller files on e-ink)"]
        </label>
    </p>
    <p>
        @L["Two-page spreads (a wide image holding two pages)"]<br />
        <label>
            <input type="radio" name="spread" value="split" @(Model.Settings.Spread == SpreadMode.Split ? "checked" : "") />
            @L["Split into two pages (left half first)"]
        </label><br />
        <label>
            <input type="radio" name="spread" value="rotate" @(Model.Settings.Spread == SpreadMode.Rotate ? "checked" : "") />
            @L["Rotate 90° (read sideways; keeps right-to-left order)"]
        </label><br />
        <label>
            <input type="radio" name="spread" value="fit" @(Model.Settings.Spread == SpreadMode.Fit ? "checked" : "") />
            @L["Whole spread on one page (complete, but small)"]
        </label>
    </p>
    <p>
        <label>@L["Page scale"]<br />
            <select name="scale">
                @foreach (var pct in Inkshelf.Auth.DeviceSettings.Scales)
                {
                    <option value="@pct" selected="@(pct == Model.Settings.Scale)">@pct%</option>
                }
            </select>
        </label><br />
        <span class="settings-note">@L["Lower this if your reader cuts off the edge of a page."]</span>
    </p>
    <p>
        <label>@L["Language"]<br />
            <select name="lang">
                @foreach (var (code, name) in Model.AvailableLanguages)
                {
                    <option value="@code" selected="@(code == Model.CurrentLang)">@name</option>
                }
            </select>
        </label>
    </p>
    <p><button type="submit" class="btn">@L["Save"]</button></p>
</form>
