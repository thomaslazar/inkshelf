@page
@using Inkshelf.Convert
@model Inkshelf.Pages.SettingsModel
<div class="page-head">
    <h1 class="page-title">
        <a href="/?all=1" class="home-link" title="@L["Libraries"]"><img src="~/img/icon-black.png" alt="" class="title-icon" /></a>
        <a href="/?all=1">@L["Libraries"]</a> <span class="crumb-sep">›</span> @L["Settings"]
    </h1>
</div>

<p class="settings-note">@L["These settings apply to this device / browser only."]</p>
@if (Model.DetectedScreen is not null)
{
    <p class="settings-note">@L["Detected screen: {0}", Model.DetectedScreen]</p>
}

<form class="settings-form" method="post" action="/settings">
    @Html.AntiForgeryToken()
    <p>
        <label>
            <input type="checkbox" name="retina" value="on" @(Model.Settings.Retina ? "checked" : "") />
            @L["Retina pages (full-resolution; crisper but heavier — may strain low-memory readers)"]
        </label>
    </p>
    <p>
        <label>
            <input type="checkbox" name="grayscale" value="on" @(Model.Settings.Grayscale ? "checked" : "") />
            @L["Grayscale pages (smaller files on e-ink)"]
        </label>
    </p>
    <p>
        <span class="setting-title">@L["Two-page spreads (a wide image holding two pages)"]</span>
        <label>
            <input type="radio" name="spread" value="splitleftfirst" @(Model.Settings.Spread == SpreadMode.SplitLeftFirst ? "checked" : "") />
            @L["Split into two pages (left half first)"]
        </label>
        <label>
            <input type="radio" name="spread" value="splitrightfirst" @(Model.Settings.Spread == SpreadMode.SplitRightFirst ? "checked" : "") />
            @L["Split into two pages (right half first)"]
        </label>
        <label>
            <input type="radio" name="spread" value="rotateright" @(Model.Settings.Spread == SpreadMode.RotateRight ? "checked" : "") />
            @L["Rotate 90° to the right"]
        </label>
        <label>
            <input type="radio" name="spread" value="rotateleft" @(Model.Settings.Spread == SpreadMode.RotateLeft ? "checked" : "") />
            @L["Rotate 90° to the left"]
        </label>
        <label>
            <input type="radio" name="spread" value="fit" @(Model.Settings.Spread == SpreadMode.Fit ? "checked" : "") />
            @L["Whole spread on one page (complete, but small)"]
        </label>
    </p>
    <p>
        <label class="setting-num">@L["Page scale"]
            <input type="number" name="scale" min="@Inkshelf.Auth.DeviceSettings.MinScale" max="100" step="1"
                   value="@Model.Settings.Scale" />
        </label>
        <span class="settings-note">@L["Percent. Lower this if your reader cuts off the edge of a page."]</span>
@if (Model.ScaleWarning)
{
        <span class="settings-note">@L["Not used: the page scale must be 50-100."]</span>
}
    </p>
    <p>
        <label>
            <input type="checkbox" name="ovr" id="ovr" value="on" @(Model.Settings.OverrideScreen ? "checked" : "") />
            @L["Override detected screen"]
        </label>
        <label class="setting-num">@L["Width"]
            <input type="number" name="ovrw" id="ovrw" min="1" max="@ScreenTarget.MaxDimension" value="@(Model.PrefillW > 0 ? Model.PrefillW.ToString() : "")" />
        </label>
        <label class="setting-num">@L["Height"]
            <input type="number" name="ovrh" id="ovrh" min="1" max="@ScreenTarget.MaxDimension" value="@(Model.PrefillH > 0 ? Model.PrefillH.ToString() : "")" />
        </label>
        <label class="setting-num">@L["Pixel ratio"]
            <input type="text" name="ovrd" id="ovrd" value="@Model.PrefillDpr" />
        </label>
        <span class="settings-note">@L["Width/height are the screen's physical pixels; a higher ratio lays pages out smaller."]</span>
@if (Model.RangeWarning)
{
        <span class="settings-note">@L["Not used: width and height must be 1-4096 and the ratio 1-4."]</span>
}
    </p>
    <p>
        <label>@L["Language"]<br />
            <select name="lang">
                @foreach (var (code, name) in Model.AvailableLanguages)
                {
                    <option value="@code" selected="@(code == Model.CurrentLang)">@name</option>
                }
            </select>
        </label>
    </p>
    <p class="settings-actions"><button type="submit" class="btn">@L["Save"]</button></p>
</form>
<script>
/* Light on purpose: ES5, no libraries, nothing an old e-reader browser cannot do.
   With JS off the fields stay enabled and the server still ignores them unless the
   checkbox is set, so the page degrades cleanly. */
(function () {
    var cb = document.getElementById("ovr");
    if (!cb) { return; }
    function sync() {
        var off = !cb.checked;
        document.getElementById("ovrw").disabled = off;
        document.getElementById("ovrh").disabled = off;
        document.getElementById("ovrd").disabled = off;
    }
    cb.onclick = sync;
    sync();
})();
</script>
